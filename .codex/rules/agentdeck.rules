# AgentDeck project-local execpolicy.
# Project trust 후 새 세션에서 로드된다. Hook이 아니라 command approval 계층이다.

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "CORE-06 v2: git push는 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["git push", "git push origin feature/example"],
    not_match = ["git status", "git log -1"],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "forbidden",
    justification = "CORE-06 v2: PR 생성은 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["gh pr create --draft"],
    not_match = ["gh pr view 1"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "CORE-06 v2: PR merge는 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["gh pr merge 1 --squash"],
    not_match = ["gh pr list"],
)

prefix_rule(
    pattern = ["gh", "release"],
    decision = "forbidden",
    justification = "CORE-06 v2: release 작업은 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["gh release create v1.0.0"],
    not_match = ["gh pr list"],
)

prefix_rule(
    pattern = ["npm", "run", "package"],
    decision = "forbidden",
    justification = "CORE-06 v2: 설치 패키지 생성은 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["npm run package"],
    not_match = ["npm run build"],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "CORE-06 v2: registry publish는 에이전트가 실행하지 않고 사용자가 통합 터미널에서 직접 실행합니다.",
    match = ["npm publish"],
    not_match = ["npm test"],
)

prefix_rule(
    pattern = ["curl"],
    decision = "forbidden",
    justification = "임의 다운로드는 프로젝트 도구 경계를 우회하므로 금지합니다.",
    match = ["curl https://example.com/file"],
    not_match = ["npm run test"],
)

prefix_rule(
    pattern = ["curl.exe"],
    decision = "forbidden",
    justification = "Windows curl 우회를 금지합니다.",
    match = ["curl.exe https://example.com/file"],
)

prefix_rule(
    pattern = ["wget"],
    decision = "forbidden",
    justification = "임의 다운로드는 프로젝트 도구 경계를 우회하므로 금지합니다.",
    match = ["wget https://example.com/file"],
    not_match = ["npm run test"],
)

prefix_rule(
    pattern = ["wget.exe"],
    decision = "forbidden",
    justification = "Windows wget 우회를 금지합니다.",
    match = ["wget.exe https://example.com/file"],
)

prefix_rule(
    pattern = ["Invoke-WebRequest"],
    decision = "forbidden",
    justification = "PowerShell 임의 다운로드 우회를 금지합니다.",
    match = ["Invoke-WebRequest https://example.com/file"],
)

prefix_rule(
    pattern = ["iwr"],
    decision = "forbidden",
    justification = "PowerShell Invoke-WebRequest alias 우회를 금지합니다.",
    match = ["iwr https://example.com/file"],
)
