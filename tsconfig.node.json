{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./02_Project/00_Source/shared/*"]
    }
  },
  "include": [
    "02_Project/00_Source/main/**/*.ts",
    "02_Project/00_Source/preload/**/*.ts",
    "02_Project/00_Source/shared/**/*.ts",
    "02_Project/01_TestCode/main/**/*.ts",
    "02_Project/01_TestCode/agents/**/*.ts",
    "02_Project/01_TestCode/shared/**/*.ts",
    "02_Project/01_TestCode/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
