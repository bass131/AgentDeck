{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/agentdeck-hook.mjs\" prompt e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb",
            "commandWindows": "$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex\\hooks\\agentdeck-hook.mjs') prompt e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb; exit $LASTEXITCODE",
            "timeout": 10,
            "statusMessage": "Loading AgentDeck work pin"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/agentdeck-hook.mjs\" subagent-start e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb",
            "commandWindows": "$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex\\hooks\\agentdeck-hook.mjs') subagent-start e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb; exit $LASTEXITCODE",
            "timeout": 10,
            "statusMessage": "Loading AgentDeck role contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/agentdeck-hook.mjs\" pre-tool e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb",
            "commandWindows": "$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex\\hooks\\agentdeck-hook.mjs') pre-tool e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Checking AgentDeck guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/agentdeck-hook.mjs\" post-tool e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb",
            "commandWindows": "$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex\\hooks\\agentdeck-hook.mjs') post-tool e1f7bdebe4871f0cf13558fc761d35f03e8e3a10b67429dc3df09cd88a7dbeeb; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Checking AgentDeck post-change gates"
          }
        ]
      }
    ]
  }
}
