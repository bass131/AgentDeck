{
  "$comment": "AgentDeck 하네스 — Claude Code 프로젝트 설정. hooks = 9종(pin-injector[UserPromptSubmit]·supervisor-guard[실행 경계·하네스 봉인·OpenGate flag]·dangerous-cmd-guard·tdd-guard·risk-detector·circuit-breaker·reviewer-auto-trigger·phase-gate-validator·convention-size-guard, .claude/hooks/*). 비가역(push/PR/merge/배포/package 릴리스)은 ask 게이트 보존(CORE-06). 헌법(CLAUDE.md)·.claude 하네스·의미 정본(00_Documents/harness·adr·ADR.md)·OpenGate(98_Management/Harness_OpenGate)는 사용자 단독 통제(CORE-11) — 기술 봉인(Edit deny + supervisor-guard, ADR-037·ADR-038). docs 일반은 규범 게이트. [OpenGate canonical: 본 파일 = 봉인판 원본. settings.json 영구 변경 시 SEALED·OPEN 두 canonical을 동기 수정할 것 — ADR-038] [HR2 P07: 경로 deny는 폴더 개명(ADR-028 개정 1) 신·구 8줄 병행. 개명 완료 후에도 옛 이름 4줄을 남기는 이유 = 부분 롤백·이력 체크아웃에서 봉인이 조용히 풀리지 않게 하기 위함. permissions에는 훅과 달리 정규식이 없어 나열이 유일한 수단이다]",

  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Bash(npm install*)",
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(npx tsc*)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -- *)",
      "Bash(git stash *)",
      "Bash(ls*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)"
    ],

    "ask": [
      "Bash(npm run package*)",
      "Bash(npm publish*)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)"
    ],

    "deny": [
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/policies/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/commands/**)",
      "Edit(.claude/settings.json)",
      "Edit(CLAUDE.md)",
      "Edit(00.Documents/harness/**)",
      "Edit(00.Documents/adr/**)",
      "Edit(00.Documents/ADR.md)",
      "Edit(98.Management/Harness_OpenGate/**)",
      "Edit(00_Documents/harness/**)",
      "Edit(00_Documents/adr/**)",
      "Edit(00_Documents/ADR.md)",
      "Edit(98_Management/Harness_OpenGate/**)"
    ]
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pin-injector.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-guard.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/dangerous-cmd-guard.sh\"" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/supervisor-guard.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-guard.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/risk-detector.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/circuit-breaker.sh\"" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-auto-trigger.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phase-gate-validator.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/convention-size-guard.sh\"" }
        ]
      }
    ]
  }
}
